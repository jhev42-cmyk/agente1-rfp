# Base de datos (Neon/Postgres). Con Vercel: `vercel env pull .env.local` trae ambas.
# DATABASE_URL: conexión con pool, la usa la app.
# DATABASE_URL_UNPOOLED: conexión directa, la usa Prisma para migraciones. Sin pooler, puede ser igual a DATABASE_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/agente1"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/agente1"

# Firma de sesiones (obligatoria en producción). Generar con: openssl rand -hex 32
AUTH_SECRET=""
